{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "welo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  // Keep Dashboard-managed variables that are intentionally not represented
  // in source control, including production-only configuration.
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "welo",
      "database_id": "9b5449af-659f-4e44-93f9-44370a4cddf3",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "SESSION_TTL_DAYS": "14",
    "CORS_ORIGINS": "https://welo.909939.xyz"
  },
  "env": {
    "development": {
      "name": "welo-api",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "welo",
          "database_id": "9b5449af-659f-4e44-93f9-44370a4cddf3",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "ENVIRONMENT": "development",
        "SESSION_TTL_DAYS": "14",
        "CORS_ORIGINS": "http://localhost:5173,http://localhost:8787"
      },
      "triggers": {
        "crons": ["*/30 * * * *"]
      }
    }
  },
  "triggers": {
    "crons": ["*/30 * * * *"]
  }
}
