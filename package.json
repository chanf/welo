{
  "name": "welo-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env development",
    "build": "tsc --noEmit",
    "frontend:dev": "npm --prefix frontend-prototype run dev",
    "frontend:build": "npm --prefix frontend-prototype run build",
    "frontend:test": "npm --prefix frontend-prototype run test",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply welo --local",
    "db:migrate:remote": "wrangler d1 migrations apply welo --remote",
    "deploy:production": "wrangler deploy",
    "test": "npm run build && npm run frontend:test"
  },
  "dependencies": {
    "hono": "^4.9.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.33.1"
  }
}
